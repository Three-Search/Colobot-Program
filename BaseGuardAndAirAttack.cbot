extern void object::BaseGuardAndAirAttack()
{
	SatCom com();
	
	int bot1 = WingedShooter;
	int bot2 = WingedOrgaShooter;

	int numBot = 1;
		
	while (found(com.ants))
	{
		if (radar(RepairCenter) == null)
		{
			produce(flatSpace(),0,RepairCenter);
		}
		
		if (!found(bot1))
		{
			for (int i = 0; i < numBot; i++)
			{
				produce(flatSpace(),0,bot1,"Shooter.cbot",100);
			}
		}
		wait(2);
		if (!found(bot2))
		{
			for (int i = 0; i < numBot; i++)
			{
				produce(flatSpace(),0,bot2,"Shooter.cbot",100);
			}
		}
		wait(2);
	}
	
}

public void object::Shooter()
{
	SatCom com();
	
	camerafocus(this);
	if (category == WingedOrgaShooter)
	{
		baseGuard(com.spaceShip,30);
	}
	else
	{
		attack();
	}
}
